# Chép thành .env rồi điền. Không commit .env.
# Lấy ở Supabase Dashboard → Project Settings → API Keys.
# Hai biến EXPO_PUBLIC_* được đóng gói vào app (công khai được, dữ liệu do RLS bảo vệ).
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Chỉ dùng phía server (Edge Function secrets), không đặt tiền tố EXPO_PUBLIC_.
GEMINI_API_KEY=
